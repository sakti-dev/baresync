{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "desktop/**/*.ts",
    "backend/**/*.ts",
    "android/**/*.ts",
    "fixture-transport.ts",
    "**/*.d.ts",
    "vitest.d.ts"
  ]
}
