{
  "compilerOptions": {
    "paths": {
      "@sync-contract/generated/*": [
        "../../packages/sync-contract/generated/*"
      ],
      "@sync-contract/*": ["../../packages/sync-contract/src/*"]
    },
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["bun", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
