{
  "name": "@example/inventory-server",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "bun run src/db/seed.ts",
    "dev": "PORT=3001 bun --hot src/index.ts",
    "build": "bunx tsc -p tsconfig.json --noEmit",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "db:generate": "bunx drizzle-kit generate --config drizzle.config.ts"
  },
  "dependencies": {
    "baresync": "file:../../../../packages/baresync",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.16"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "0.31.4",
    "@types/node": "^24.0.10",
    "typescript": "5.9.2"
  }
}
