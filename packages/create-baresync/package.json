{
  "name": "create-baresync",
  "version": "0.2.1",
  "private": false,
  "type": "module",
  "description": "Scaffold Baresync starter workspaces",
  "license": "MIT",
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "create-baresync": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun run src/build.ts",
    "typecheck": "bun x tsc -p tsconfig.json --noEmit",
    "test": "bun x vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@clack/prompts": "1.4.0",
    "jsonrepair": "^3.14.0",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "typescript": "5.9.2",
    "vitest": "^4.1.6"
  }
}
