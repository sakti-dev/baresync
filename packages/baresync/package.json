{
  "name": "baresync",
  "version": "0.4.0",
  "private": false,
  "type": "module",
  "description": "SQLite-first sync infrastructure for Tauri apps",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakti-dev/baresync.git"
  },
  "keywords": [
    "sqlite",
    "sync",
    "tauri",
    "drizzle",
    "offline-first"
  ],
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "files": [
    "dist",
    ".pack",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./generator": {
      "types": "./dist/generator/index.d.ts",
      "default": "./dist/generator/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./server/drizzle": {
      "types": "./dist/server/drizzle.d.ts",
      "default": "./dist/server/drizzle.js"
    },
    "./tauri": {
      "types": "./dist/tauri/index.d.ts",
      "default": "./dist/tauri/index.js"
    },
    "./limits": {
      "types": "./dist/limits.d.ts",
      "default": "./dist/limits.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "bin": {
    "baresync": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsup",
    "build:types": "bun x tsc -p tsconfig.build.json --emitDeclarationOnly",
    "prepack": "bun run build && bun run pack:skills:stage",
    "postpack": "bun run pack:skills:clean",
    "pack:skills:stage": "bun ./scripts/stage-skills.mjs",
    "pack:skills:clean": "bun ./scripts/clean-skills-pack.mjs",
    "pack:dry-run": "bun pm pack --dry-run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@clack/prompts": "1.4.0",
    "drizzle-orm": "^0.45.2",
    "prettier": "^3.6.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.1",
    "@libsql/client": "^0.17.3",
    "@miniflare/d1": "^2.14.4",
    "@neondatabase/serverless": "^1.1.0",
    "@planetscale/database": "^1.20.1",
    "@tidbcloud/serverless": "^0.3.0",
    "@vercel/postgres": "^0.10.0",
    "@xata.io/client": "^0.30.1",
    "@types/node": "^22.15.0",
    "mysql2": "^3.14.5",
    "pg": "^8.16.3",
    "postgres": "^3.4.9",
    "tsup": "^8.5.1",
    "typescript": "5.9.2",
    "vitest": "^4.1.6"
  }
}
